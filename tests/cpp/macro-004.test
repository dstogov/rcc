--TEST--
Macro 004 - valid macros join
--ARGS--
-E -P
--CODE--
#define A2(a,b) a ## b 
#define A3(a,b...) a ## b 
#define A4(a,b,...) a ## b ## __VA_ARGS__
A2(1,2)
A2(,2)
A2(1,)
A2(1,2)
A3(1,2)
A3(1,2,)
A3(1,2,3)
A3(1,2,3,4)
A4(1,2)
A4(1,2,)
A4(1,2,3)
A4(1,2,3,4)
--EXPECT--
12
2
1
12
12
12,
12,3
12,3,4
12
12
123
123,4
