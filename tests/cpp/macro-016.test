--TEST--
Macro 016 - valid macros substitution
--ARGS--
-E -P
--CODE--
#define A1(a) a
#define A2(a) #a
#define A3(a,b) a b 
#define A4(a,b) a ## b 
#define A5(a,b...) a ## b 
#define A6(a,b,...) a ## b #__VA_ARGS__
A1()
A2()
A3(1,2)
A4(1,2)
A5(1,2,3,4)
A6(1,2,3,4)
--EXPECT--
""
1 2
12
12,3,4
12 "3,4"
