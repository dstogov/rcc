--TEST--
if 001:
--ARGS--
-O1 --save-ir-after-load
--CODE--
int test1(int c) {
	if (c) c = 100;
	return c;
}
int test2(int c) {
	if (c) {
		c++;
	} else {
		c = 42;
	}
	return c;
}
--EXPECT--
func @test1(int32_t): int32_t
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 100;
	l_1 = START(l_14);
	int32_t d_2 = PARAM(l_1, "c", 1);
	int32_t d_3 = VAR(l_1, "c");
	l_4 = VSTORE(l_1, d_3, d_2);
	uintptr_t d_5, l_5 = BLOCK_BEGIN(l_4);
	l_6 = IF(l_5, d_2);
	l_7 = IF_TRUE(l_6);
	l_8 = VSTORE(l_7, d_3, c_4);
	l_9 = END(l_8);
	l_10 = IF_FALSE(l_6);
	l_11 = END(l_10);
	l_12 = MERGE(l_9, l_11);
	int32_t d_13, l_13 = VLOAD(l_12, d_3);
	l_14 = RETURN(l_13, d_13);
}
func @test2(int32_t): int32_t
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 1;
	int32_t c_5 = 42;
	l_1 = START(l_16);
	int32_t d_2 = PARAM(l_1, "c", 1);
	int32_t d_3 = VAR(l_1, "c");
	l_4 = VSTORE(l_1, d_3, d_2);
	uintptr_t d_5, l_5 = BLOCK_BEGIN(l_4);
	l_6 = IF(l_5, d_2);
	l_7 = IF_TRUE(l_6);
	int32_t d_8 = ADD(d_2, c_4);
	l_9 = VSTORE(l_7, d_3, d_8);
	l_10 = END(l_9);
	l_11 = IF_FALSE(l_6);
	l_12 = VSTORE(l_11, d_3, c_5);
	l_13 = END(l_12);
	l_14 = MERGE(l_10, l_13);
	int32_t d_15, l_15 = VLOAD(l_14, d_3);
	l_16 = RETURN(l_15, d_15);
}
