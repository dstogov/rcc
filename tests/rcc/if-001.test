--TEST--
if 001:
--ARGS--
-O1 --save-ir-after-load
--CODE--
int test1(int c) {
	if (c) c = 100;
	return c;
}
int test2(int c) {
	if (c) {
		c++;
	} else {
		c = 42;
	}
	return c;
}
--EXPECT--
func @test1(int32_t): int32_t
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 100;
	l_1 = START(l_13);
	int32_t d_2 = PARAM(l_1, "c", 1);
	int32_t d_3 = VAR(l_1, "c");
	l_4 = VSTORE(l_1, d_3, d_2);
	l_5 = IF(l_4, d_2);
	l_6 = IF_TRUE(l_5);
	l_7 = VSTORE(l_6, d_3, c_4);
	l_8 = END(l_7);
	l_9 = IF_FALSE(l_5);
	l_10 = END(l_9);
	l_11 = MERGE(l_8, l_10);
	int32_t d_12, l_12 = VLOAD(l_11, d_3);
	l_13 = RETURN(l_12, d_12);
}
func @test2(int32_t): int32_t
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 1;
	int32_t c_5 = 42;
	l_1 = START(l_15);
	int32_t d_2 = PARAM(l_1, "c", 1);
	int32_t d_3 = VAR(l_1, "c");
	l_4 = VSTORE(l_1, d_3, d_2);
	l_5 = IF(l_4, d_2);
	l_6 = IF_TRUE(l_5);
	int32_t d_7 = ADD(d_2, c_4);
	l_8 = VSTORE(l_6, d_3, d_7);
	l_9 = END(l_8);
	l_10 = IF_FALSE(l_5);
	l_11 = VSTORE(l_10, d_3, c_5);
	l_12 = END(l_11);
	l_13 = MERGE(l_9, l_12);
	int32_t d_14, l_14 = VLOAD(l_13, d_3);
	l_15 = RETURN(l_14, d_14);
}
