--TEST--
Initializers 020:
--ARGS--
-O0 --run
-O1 --run
-O2 --run
--CODE--
extern const char *printf(const char *msg, ...);
struct {int x; char a[];} s = {1, "abcd"}; 
_Static_assert(sizeof(s) == 4);
int main() {
	struct {int x; char a[];} s2 = {1, "dcba"}; 
	printf("%s\n", s.a);
	printf("%s\n", s2.a);
	return 0;
}
--EXPECT--
./tests/rcc/init-020.c:5:43: error: non-static initialization of flexible array member is not allowed

exit code = 1
