--TEST--
__attribute__((musttail)) 003:
--ARGS--
--run
--CODE--
int printf(const char *, ...);
int bar(int x) {
	return x * 2;
}
int foo(int x, ...) {
	__attribute__((musttail)) return bar(x);
}
int main() {
	printf("%d\n", foo(21));
	return 0;
}
--EXPECT--
./tests/rcc/musttail-003.c:7:1: error: cannot tail-call: variadic functions are not supported

exit code = 1
