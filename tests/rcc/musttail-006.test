--TEST--
__attribute__((musttail)) 006:
--ARGS--
--run
--CODE--
int printf(const char *, ...);
int bar(int x, int y) {
	return x * y;
}
int foo(int x) {
	__attribute__((musttail)) return bar(x, 2);
}
int main() {
	printf("%d\n", foo(21));
	return 0;
}
--EXPECT--
./tests/rcc/musttail-006.c:7:1: error: cannot tail-call: incompatible function prototypes

exit code = 1
