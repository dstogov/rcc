--TEST--
__attribute__((musttail)) 013:
--ARGS--
--run
--CODE--
int printf(const char *, ...);
int bar(int x) {
	return x * 2;
}
int foo(int x) {
	__attribute__((musttail)) return bar(x) + x;
}
int main() {
	printf("%d\n", foo(21));
	return 0;
}
--EXPECT--
./tests/rcc/musttail-013.c:7:1: error: cannot tail-call: return value must be a call

exit code = 1
