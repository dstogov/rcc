--TEST--
tinycc 060.46: error and warnings
--ARGS--
--run
--CODE--
#define P(n,v) printf("%-5s: %d ; %d\n", __FUNCTION__, n, v)
int bar();
int printf(const char*, ...);
int main ()
{
    {
        extern int xxx[
        2
        ];
        P(1, xxx[0]);
        xxx[0] += 2;
    }
    bar(123);
    return 0;
}
int xxx[1] = {1};
int bar() { P(3, xxx[0]); return 0; }

--EXPECT--
./tests/tinycc/tests2/060_46_errors_and_warnings.c:16:12: error: incompatible redeclaration of "xxx"

exit code = 1
