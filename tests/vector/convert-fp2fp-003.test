--TEST--
CONVERT.FP2FP.003: 256-bit vectors AVX
--TARGET--
x86*
--ARGS--
-mavx --run
--CODE--
int printf(const char *, ...);

typedef double __attribute__((__vector_size__(32))) v_d;
typedef float  __attribute__((__vector_size__(16))) v_f;

v_f __attribute__((noinline)) test_d_f(v_d v)
{
	return __builtin_convertvector(v, v_f);
}

v_d __attribute__((noinline)) test_f_d(v_f v)
{
	return __builtin_convertvector(v, v_d);
}

int main()
{
	{
		v_d x = {1.1, 2.2, 3.3, 4.4};
		v_f y = test_d_f(x);
		printf("%g %g %g %g\n", y[0], y[1], y[2], y[3]);
	}

	{
		v_f x = {1.1f, 2.2f, 3.3f, 4.4f};
		v_d y = test_f_d(x);
		printf("%g %g %g %g\n", y[0], y[1], y[2], y[3]);
	}

	return 0;
}
--EXPECT--
1.1 2.2 3.3 4.4
1.1 2.2 3.3 4.4
