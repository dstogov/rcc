--TEST--
CONVERT.FP2FP.101: 128-bit vectors (NEON)
--TARGET--
aarch64
--ARGS--
--run
--CODE--
int printf(const char *, ...);

typedef double __attribute__((__vector_size__(16))) v_2d;
typedef float  __attribute__((__vector_size__(8)))  v_4f;

v_4f __attribute__((noinline)) test_d_f(v_2d v)
{
	return __builtin_convertvector(v, v_4f);
}

v_2d __attribute__((noinline)) test_f_d(v_4f v)
{
	return __builtin_convertvector(v, v_2d);
}

int main()
{
	{
		v_2d x = {1.1, 2.2};
		v_4f y = test_d_f(x);
		printf("%g %g\n", y[0], y[1]);
	}

	{
		v_4f x = {1.1f, 2.2f};
		v_2d y = test_f_d(x);
		printf("%g %g\n", y[0], y[1]);
	}

	return 0;
}
--EXPECT--
1.1 2.2
1.1 2.2
